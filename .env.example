# The demo shown during this talk was done with Aiven's OpenSearch service.
# Create your own OpenSearch service at https://console.aiven.io/ and get the credentials here.
# https://aiven.io/opensearch
OPENSEARCH_URL=https://your-service-host:port
OPENSEARCH_USERNAME=avnadmin
OPENSEARCH_PASSWORD=

# Select an OpenSearch-provided local model by name. The provisioning script
# derives its version, format, function, and vector dimension from the catalog.
LOCAL_MODEL_NAME=huggingface/sentence-transformers/multi-qa-MiniLM-L6-cos-v1

# OpenAI-compatible model endpoint. This configuration uses Aiven AI Gateway.
LLM_BASE_URL=https://ai.aiven.io/v1
LLM_MODEL_NAME=claude-sonnet-5
LLM_API_KEY=
# put your own LLM provider name here
LLM_CONNECTOR_NAME=aiven-ai-gateway
LLM_REMOTE_MODEL_NAME=aiven-claude-sonnet-5

# Account token used only to provision an Aiven AI Gateway key.
AIVEN_TOKEN=
